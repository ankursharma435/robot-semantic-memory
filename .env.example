# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# ── 1. The one key that covers almost everything ──────────────────────────
# Get this at https://build.nvidia.com — free account, email verification,
# then open any model page -> "Get API Key". Looks like: nvapi-xxxxxxxxxxxx
# Used for: NV-CLIP, the VLM escalation path, AND as the Riva "Bearer" token.
NVIDIA_API_KEY=

# ── 2. Riva function IDs — one per speech model, model-specific ───────────
# Since you're using Magpie for TTS:
#   ASR: nvidia/parakeet-ctc-0.6b-asr          (English, CTC, fast, streaming+batch)
#   TTS: nvidia/magpie-tts-multilingual         (the one you have keys for)
# On build.nvidia.com, open that model's page -> "API" tab. You'll see a
# `--metadata "function-id" "<uuid>"` line in the sample code — copy that
# uuid here. IDs are model-specific, so re-copy if you switch models later.
RIVA_ASR_FUNCTION_ID=
RIVA_TTS_FUNCTION_ID=

# Voice name for Magpie (named-voice scheme, not a single default voice).
# Confirm the exact string with --list-voices:
#   python python-clients/scripts/tts/talk.py --server grpc.nvcf.nvidia.com:443 \
#     --use-ssl --metadata function-id "<your-tts-function-id>" \
#     --metadata authorization "Bearer $NVIDIA_API_KEY" --list-voices
# Starting guess based on Magpie's docs — verify against your own output:
RIVA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria

# ── 3. Model identifiers you pick from the catalog ─────────────────────────
# NV-CLIP's model id on the REST endpoint (confirm exact string on its page).

# Any vision-capable chat model from the "Vision Language Models" section of
# the catalog — this is your escalation-path stand-in. Copy the exact model
# id string from that model's own API tab; catalog ids do shift over time.
# Changed 2026-09-03: meta/llama-3.2-90b-vision-instruct read-timed-out on this
# account even for a text-only request (90s and 150s timeouts). The 11b variant
# answers the same image+text payload in ~0.6s, so the content-block shape in
# nvidia_nim.call_vlm_escalation() was never the problem -- only the model id.
VLM_MODEL=meta/llama-3.2-11b-vision-instruct

# ── 4. Fixed endpoints (shouldn't need to change) ──────────────────────────
NVIDIA_INTEGRATE_BASE_URL=https://integrate.api.nvidia.com/v1
RIVA_GRPC_SERVER=grpc.nvcf.nvidia.com:443

# The fixed-width baseline embedder used for the 'c' comparison beat.
# Changed 2026-09-04: nvidia/nvclip is DISCONTINUED by NVIDIA and always
# 404s. Replacement verified live -- multimodal (text AND images), fixed
# width 2048 dims, ~0.8s, and cross-modal Recall@1 4/4 on the synthetic
# test scenes, so it is a strong baseline rather than a strawman.
# NVCLIP_MODEL is still read first if present, for older .env files.
BASELINE_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
